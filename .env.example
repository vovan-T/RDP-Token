# Generate a random secret with scripts/create-env.sh. Never commit .env.
RDP_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_CREATE_ENV_SCRIPT
# Hexadecimal SERIAL OF THE ADMIN CERTIFICATE, not token hardware serial.
RDP_TOKEN_BOOTSTRAP_ADMIN_SERIAL=CHANGE_ME
RDP_TOKEN_HTTPS_PORT=18443
RDP_TOKEN_APP_PORT=18081
RDP_TOKEN_SERVER_CERT=/etc/letsencrypt/live/rdp.example.invalid/fullchain.pem
RDP_TOKEN_SERVER_KEY=/etc/letsencrypt/live/rdp.example.invalid/privkey.pem
RDP_TOKEN_CLAIM_SECONDS=50
RDP_TOKEN_HEARTBEAT_GRACE_SECONDS=12
RDP_TOKEN_PUBLIC_RDP_HOST=rdp.example.invalid
RDP_TOKEN_PORT_MIN=60000
RDP_TOKEN_PORT_MAX=60999
